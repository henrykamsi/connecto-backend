    const existing = await query(
      `SELECT c.id
       FROM conversations c
       JOIN conversation_members a ON a.conversation_id=c.id
       JOIN conversation_members b ON b.conversation_id=c.id
       WHERE c.type='direct'
         AND a.user_id=$1
